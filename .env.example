# ============================================================
# CloudyBreeze Environment Variables
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file to version control.
# ============================================================

PORT=3000
NODE_ENV=development

# Supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

SESSION_SECRET=your-random-session-secret-here

# ============================================================
# MojaPOS
# ============================================================
# Development should use the sandbox/test project.
MOJAPOS_ENVIRONMENT=sandbox

# MojaPOS publishable project key. Use pk_test_... for sandbox.
MOJAPOS_PUBLISHABLE_KEY=pk_test_your_key_here

# CloudyBreeze store payment currency. Peach sandbox supports USD,
# SZL, ZAR and EUR according to the MojaPOS test environment.
MOJAPOS_PAYMENT_CURRENCY=USD

# Public HTTPS URL used for payment callbacks/webhooks in deployment.
PUBLIC_BASE_URL=https://your-domain.com

# Optional webhook verification secret if MojaPOS supplies one.
MOJAPOS_WEBHOOK_SECRET=your-mojapos-webhook-secret

# Keep any MojaPOS secret credentials server-side only.
MOJAPOS_SECRET_KEY=
