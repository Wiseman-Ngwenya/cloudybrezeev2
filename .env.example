# ============================================================
# CloudyBreeze Environment Variables
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file to version control.
# ============================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Supabase Configuration
# Get these from your Supabase project dashboard:
# Settings > API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Session Configuration
# Generate a random string for session encryption.
# Example: openssl rand -hex 32
SESSION_SECRET=your-random-session-secret-here

# ============================================================
# MojaPOS Payment Gateway
# ============================================================
# Use the sandbox values during development.
# Keep all real API keys server-side. Never expose them in
# frontend JavaScript, HTML, or public assets.

# sandbox | production
MOJAPOS_ENVIRONMENT=sandbox

# MojaPOS API base URL supplied by MojaPOS
MOJAPOS_API_URL=https://<mojapos-sandbox-api-url>

# MojaPOS merchant identifier
MOJAPOS_MERCHANT_ID=your-mojapos-merchant-id

# MojaPOS sandbox API key
MOJAPOS_API_KEY=your-mojapos-sandbox-api-key

# MojaPOS webhook signing/verification secret, if supplied
MOJAPOS_WEBHOOK_SECRET=your-mojapos-webhook-secret

# Public HTTPS URL where MojaPOS will send payment status updates
MOJAPOS_WEBHOOK_URL=https://your-domain.com/api/payments/mojapos/webhook

# Optional production values. Keep these empty until live credentials
# and the production API URL have been supplied by MojaPOS.
MOJAPOS_PRODUCTION_API_URL=
MOJAPOS_PRODUCTION_API_KEY=
